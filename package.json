{
  "name": "openelement",
  "private": true,
  "version": "1.0.0-alpha.11",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "check": "node tools/repo/gate.ts fmt:check lint typecheck @openelement/tools-repo#lint:markdown",
    "check:dep-age": "node tools/repo/check-dependency-age.ts",
    "test": "pnpm run generate:all && vitest run --project element --project compiler --project router --project create --project ui --project saas --project www --project tools --project tests --project benchmarks",
    "test:e2e": "node tools/repo/gate.ts site:build @openelement/www#e2e:browsers @openelement/fixture-router-native-framework#e2e @openelement/fixture-router-lit-framework#e2e",
    "build": "pnpm -r --filter @openelement/protocol --filter @openelement/element --filter @openelement/compiler --filter @openelement/router --filter @openelement/create --filter @openelement/ui run build",
    "verify": "node tools/repo/gate.ts check test @openelement/tools-repo#gate:source saas:verify saas:workers @openelement/tools-release#gate:packed",
    "release:check": "node tools/repo/gate.ts @openelement/tools-repo#generate:all @openelement/tools-repo#release:registry-check @openelement/tools-repo#gate:release @openelement/tools-release#gate:packed @openelement/tools-release#publish:npm:dry-run",
    "site:build": "node tools/repo/gate.ts @openelement/tools-repo#generate:all @openelement/www#build @openelement/www#pagefind @openelement/www#emit:redirects @openelement/www#emit:sitemap @openelement/www#emit:rss",
    "pages:build": "vp run site:build",
    "site:verify": "node tools/repo/gate.ts site:build @openelement/www#check:links @openelement/www#check:theme-tokens @openelement/www#check:content @openelement/tools-repo#retired-api:check",
    "generate:all": "node tools/repo/generate-all.ts",
    "saas:verify": "node tools/repo/gate.ts @openelement/saas#check @openelement/saas#test",
    "clean": "node tools/repo/clean.ts",
    "clean:deep": "node tools/repo/clean.ts --deep",
    "bench": "vitest run --project benchmarks",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "pnpm -r --filter @openelement/protocol --filter @openelement/element --filter @openelement/compiler --filter @openelement/router --filter @openelement/create --filter @openelement/ui run typecheck",
    "gate:release": "node tools/repo/gate.ts @openelement/tools-repo#gate:release @openelement/tools-release#gate:packed",
    "saas:workers": "node tools/repo/gate.ts @openelement/saas#build @openelement/saas#nitro:build-workers @openelement/tools-repo#workers:boundary-check",
    "verify:core": "node tools/repo/gate.ts @openelement/tools-repo#gate:source @openelement/tools-release#gate:packed",
    "prepare": "vp run --fail-if-no-match @openelement/tools-repo#hooks:install"
  },
  "devDependencies": {
    "@openelement/compiler": "workspace:*",
    "@openelement/element": "workspace:*",
    "@openelement/ui": "workspace:*",
    "@playwright/test": "1.59.1",
    "@types/node": "26.5.0",
    "@types/semver": "7.8.0",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.59.1",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plus": "1.0.0",
    "vitest": "5.0.2"
  }
}

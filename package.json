{
  "name": "openelement",
  "private": true,
  "version": "1.0.0-alpha.7",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node tools/repo/gate.ts fmt:check lint typecheck tools/repo#lint:markdown",
    "check:dep-age": "node tools/repo/check-dependency-age.ts",
    "test": "pnpm run generate && vitest run --project element --project router --project create --project ui --project saas --project www --project tools --project tests --project benchmarks",
    "test:element": "pnpm --filter @openelement/element run test",
    "test:router": "pnpm --filter @openelement/router run test",
    "test:e2e": "node tools/repo/gate.ts site:build www#e2e:browsers tests/fixtures/router-native-framework#e2e tests/fixtures/router-lit-framework#e2e",
    "build": "pnpm -r --filter @openelement/element --filter @openelement/router --filter @openelement/create --filter @openelement/ui run build",
    "pack": "pnpm --dir tools/release run pack",
    "verify": "node tools/repo/gate.ts check test tools/repo#gate:source saas:verify saas:workers tools/release#gate:packed",
    "release:check": "node tools/repo/gate.ts tools/repo#generate:all tools/repo#release:registry-check tools/repo#gate:release tools/release#gate:packed tools/release#publish:npm:dry-run",
    "site:build": "node tools/repo/gate.ts tools/repo#generate:all www#build www#pagefind www#emit:redirects www#emit:sitemap www#emit:rss",
    "site:verify": "node tools/repo/gate.ts site:build www#check:links www#check:theme-tokens www#check:content tools/repo#retired-api:check",
    "generate": "node tools/repo/generate-all.ts",
    "generate:all": "node tools/repo/generate-all.ts",
    "saas:build": "pnpm --dir apps/saas run build",
    "saas:verify": "node tools/repo/gate.ts apps/saas#check apps/saas#test",
    "clean": "node tools/repo/clean.ts",
    "clean:deep": "node tools/repo/clean.ts --deep",
    "bench": "vitest run --project benchmarks",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "pnpm -r --filter @openelement/element --filter @openelement/router --filter @openelement/create --filter @openelement/ui run typecheck",
    "gate:release": "node tools/repo/gate.ts tools/repo#gate:release tools/release#gate:packed",
    "saas:workers": "node tools/repo/gate.ts apps/saas#build apps/saas#nitro:build-workers tools/repo#workers:boundary-check",
    "verify:core": "node tools/repo/gate.ts tools/repo#gate:source tools/release#gate:packed"
  },
  "devDependencies": {
    "@openelement/element": "workspace:*",
    "@openelement/ui": "workspace:*",
    "@playwright/test": "1.59.1",
    "@std/assert": "jsr:^1.0.0",
    "@std/cli": "jsr:^1.0.0",
    "@std/fs": "jsr:^1.0.0",
    "@std/path": "jsr:^1.0.0",
    "@std/semver": "jsr:^1.0.0",
    "@types/node": "26.5.0",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "esbuild": "0.25.12",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.59.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.2"
  }
}

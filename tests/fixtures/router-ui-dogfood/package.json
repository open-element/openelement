{
  "name": "@openelement/fixture-router-ui-dogfood",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node ../../../tools/repo/clean.ts dist && node ../../../packages/router/src/cli/build.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts --project=chromium",
    "e2e:browsers": "playwright test --config e2e/playwright.config.ts",
    "gate": "node ../../../tools/repo/gate.ts @openelement/fixture-router-ui-dogfood#typecheck @openelement/fixture-router-ui-dogfood#build @openelement/fixture-router-ui-dogfood#e2e:browsers",
    "e2e:dev": "playwright test --config e2e/playwright.dev.config.ts --project=chromium",
    "e2e:dev:browsers": "playwright test --config e2e/playwright.dev.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@openelement/element": "workspace:*",
    "@openelement/router": "workspace:*",
    "@openelement/ui": "workspace:*",
    "hono": "^4.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.0.16"
  }
}

{
  "name": "@openelement/fixture-third-party-web-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//": "The qualify harness runs on the Deno host (Deno.* in qualify.ts/snapshot-prototype.ts); scripts keep `deno run` until the qualify-harness port.",
  "scripts": {
    "smoke": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys qualify.ts",
    "snapshot:prototype": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys snapshot-prototype.ts"
  },
  "dependencies": {
    "@openelement/element": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@std/path": "jsr:^1.0.0"
  }
}

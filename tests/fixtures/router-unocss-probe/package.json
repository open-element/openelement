{
  "name": "@openelement/fixture-router-unocss-probe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node ../../../tools/repo/clean.ts dist && node ../../../packages/router/src/cli/build.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts --project=chromium",
    "e2e:browsers": "playwright test --config e2e/playwright.config.ts",
    "gate": "node ../../../tools/repo/gate.ts @openelement/fixture-router-unocss-probe#typecheck @openelement/fixture-router-unocss-probe#build @openelement/fixture-router-unocss-probe#e2e:browsers",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openelement/element": "workspace:*",
    "@openelement/router": "workspace:*",
    "hono": "^4.12",
    "open-props": "1.7.23",
    "unocss": "66.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "vite": "8.0.16"
  }
}

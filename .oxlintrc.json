{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "allow",
    "suspicious": "allow",
    "pedantic": "allow",
    "perf": "allow",
    "style": "allow",
    "restriction": "allow",
    "nursery": "allow"
  },
  "rules": {
    "adjacent-overload-signatures": "deny",
    "ban-ts-comment": [
      "deny",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "ts-check": "allow-with-description"
      }
    ],
    "ban-types": "deny",
    "button-has-type": "deny",
    "constructor-super": "deny",
    "for-direction": "deny",
    "getter-return": "deny",
    "jsx-boolean-value": "deny",
    "jsx-curly-brace-presence": "deny",
    "jsx-key": "deny",
    "jsx-no-comment-textnodes": "deny",
    "jsx-no-duplicate-props": "deny",
    "jsx-no-useless-fragment": "deny",
    "jsx-props-no-spread-multi": "deny",
    "no-array-constructor": "deny",
    "no-async-promise-executor": "deny",
    "no-case-declarations": "deny",
    "no-children-prop": "deny",
    "no-class-assign": "deny",
    "no-compare-neg-zero": "deny",
    "no-cond-assign": "deny",
    "no-const-assign": "deny",
    "no-constant-condition": "deny",
    "no-control-regex": "deny",
    "no-debugger": "deny",
    "no-delete-var": "deny",
    "no-dupe-class-members": "deny",
    "no-dupe-else-if": "deny",
    "no-dupe-keys": "deny",
    "no-duplicate-case": "deny",
    "no-empty": "deny",
    "no-empty-character-class": "deny",
    "no-empty-interface": [
      "deny",
      {
        "allowSingleExtends": true
      }
    ],
    "no-empty-pattern": "deny",
    "no-ex-assign": "deny",
    "no-explicit-any": "deny",
    "no-extra-boolean-cast": "deny",
    "no-extra-non-null-assertion": "deny",
    "no-fallthrough": "deny",
    "no-func-assign": "deny",
    "no-global-assign": "deny",
    "no-import-assign": "deny",
    "no-inner-declarations": "deny",
    "no-invalid-regexp": "deny",
    "no-irregular-whitespace": "deny",
    "no-misused-new": "deny",
    "no-namespace": "deny",
    "no-new-native-nonconstructor": "deny",
    "no-obj-calls": "deny",
    "no-prototype-builtins": "deny",
    "no-redeclare": "deny",
    "no-regex-spaces": "deny",
    "no-self-assign": "deny",
    "no-setter-return": "deny",
    "no-shadow-restricted-names": "deny",
    "no-this-alias": "deny",
    "no-this-before-super": "deny",
    "no-unescaped-entities": "deny",
    "no-unreachable": "deny",
    "no-unsafe-finally": "deny",
    "no-unsafe-negation": "deny",
    "no-unused-labels": "deny",
    "no-unused-vars": "deny",
    "no-var": "deny",
    "no-with": "deny",
    "prefer-as-const": "deny",
    "prefer-const": "deny",
    "prefer-namespace-keyword": "deny",
    "require-await": "deny",
    "require-yield": "deny",
    "triple-slash-reference": "deny",
    "use-isnan": "deny",
    "valid-typeof": "deny",
    "void-dom-elements-no-children": "deny"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "**/dist/**",
    ".deno/",
    "custom-dist/",
    "dist-test-ssg-render/",
    "vendor/",
    "**/.nitro/",
    "**/.work/",
    "packages/element/__wtr__/",
    "www/content/",
    "www/app/data/",
    "www/public/assets/vendor/"
  ]
}

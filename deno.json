{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "workspace": [
    "./packages/element",
    "./packages/ui",
    "./packages/create",
    "./packages/router",
    "./apps/saas",
    "./apps/site",
    "./tools/repo",
    "./tools/release",
    "./tests/e2e/starter-smoke",
    "./tests/fixtures/site-light-probe"
  ],
  "imports": {
    "@openelement/url-pattern-list": "npm:@openelement/url-pattern-list@0.6.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.0.0",
    "@std/fs/walk": "jsr:@std/fs@^1.0.0/walk",
    "@std/cli/parse-args": "jsr:@std/cli@^1.0.0/parse-args",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "hono": "npm:hono@^4.12",
    "vite": "npm:vite@8.0.16",
    "typescript": "npm:typescript@6.0.3",
    "@types/node": "npm:@types/node@26.5.0",
    "yaml": "npm:yaml@^2.8.1",
    "@playwright/test": "npm:@playwright/test@1.59.1",
    "@jridgewell/trace-mapping": "npm:@jridgewell/trace-mapping@0.3.31",
    "preact": "npm:preact@^10.28.0",
    "@preact/signals-core": "npm:@preact/signals-core@^1.12.1",
    "@lit/context": "npm:@lit/context@1.1.6",
    "lit": "npm:lit@3.3.3",
    "@lit-labs/ssr": "npm:@lit-labs/ssr@4.1.0",
    "@lit-labs/ssr-client": "npm:@lit-labs/ssr-client@1.1.8",
    "@zag-js/combobox": "npm:@zag-js/combobox@1.43.3",
    "@zag-js/vanilla": "npm:@zag-js/vanilla@1.43.3",
    "nitro": "npm:nitro@3.0.260610-beta",
    "zod": "npm:zod@^3.25",
    "valibot": "npm:valibot@^1.1",
    "marked": "npm:marked@^15.0.0",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "@openelement/site-ui/": "./apps/site/app/site-ui/",
    "@openelement/generated/blog-data": "./apps/site/app/data/_generated-blog-data.ts",
    "pagefind": "npm:pagefind@^1.4.0"
  },
  "vendor": true,
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno run --allow-run tools/repo/gate.ts fmt:check lint typecheck tools/repo#lint:markdown",
    "test": "deno task --cwd tools/repo generate:site-content-data && deno task --cwd tools/repo generate:api-reference && deno test --no-prompt --ignore=packages/element/__wtr__,apps/saas,tests/fixtures --allow-read --allow-write --allow-env --allow-net --allow-run --allow-ffi --allow-sys",
    "test:e2e": "deno run --allow-run tools/repo/gate.ts site:build apps/site#e2e:browsers tests/fixtures/router-native-framework#e2e tests/fixtures/router-lit-framework#e2e",
    "build": "deno task --filter @openelement/element build && deno task --filter @openelement/router build && deno task --filter @openelement/create build && deno task --filter @openelement/ui build",
    "pack": "deno task --cwd tools/release pack",
    "verify": "deno run --allow-run tools/repo/gate.ts check test test:e2e site:verify saas:verify tools/release#gate:packed",
    "release:check": "deno run --allow-run tools/repo/gate.ts tools/repo#release:registry-check tools/release#gate:packed tools/release#publish:npm:dry-run",
    "site:build": "deno run --allow-run tools/repo/gate.ts tools/repo#generate:site-content-data tools/repo#generate:api-reference apps/site#build apps/site#pagefind tools/repo#site:sitemap",
    "site:verify": "deno run --allow-run tools/repo/gate.ts site:build tools/repo#site:check-links tools/repo#site:check-theme-tokens tools/repo#content-examples:check tools/repo#retired-api:check",
    "saas:build": "deno task --cwd apps/saas build",
    "saas:verify": "deno run --allow-run tools/repo/gate.ts apps/saas#check apps/saas#test",
    "clean": "deno run --allow-read --allow-write tools/repo/clean.ts",
    "clean:deep": "deno run --allow-read --allow-write tools/repo/clean.ts --deep",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno task --filter @openelement/element typecheck && deno task --filter @openelement/router typecheck && deno task --filter @openelement/create typecheck && deno task --filter @openelement/ui typecheck",
    "gate:ci": "deno run --allow-run tools/repo/gate.ts tools/repo#gate:source tools/release#gate:packed"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      "apps/site/content/blog/",
      "apps/site/content/guide/",
      "apps/site/app/data/",
      "apps/site/public/assets/",
      "custom-dist/",
      "dist-test-ssg-render/",
      ".tmp*",
      "**/.nitro/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-explicit-any"
      ],
      "exclude": [
        "no-sloppy-imports"
      ]
    },
    "exclude": [
      "apps/site/content/blog/",
      "apps/site/content/guide/",
      "apps/site/app/data/",
      "apps/site/public/assets/vendor/",
      "custom-dist/",
      "dist-test-ssg-render/",
      "**/.nitro/"
    ]
  },
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@openelement/element"
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/node_modules/**",
    ".deno",
    "custom-dist",
    "dist-test-ssg-render",
    "vendor",
    "**/.nitro",
    "**/.work",
    "packages/element/__wtr__"
  ]
}

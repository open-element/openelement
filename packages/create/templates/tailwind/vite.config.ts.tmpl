import { applyTailwindPreset, openElement } from '@openelement/router/vite';
import { defineConfig, type Plugin, type ResolvedConfig } from 'vite';

// Vite configuration only. Framework options live in openelement.config.ts —
// the plugin reads that file itself, so the plugin call stays
// `openElement()`. The JSX transform is owned by the plugin's compiler pass
// (TSX → Part Program); nothing JSX-related needs configuring here.
//
// Tailwind role sheet (scaffolded ON): the roles in app/styles/theme.css are
// compiled into the preset's linked, layer-ordered bundle at build time and
// referenced from every rendered page with <link rel="stylesheet">. The role
// file is declared relative to the preset's build-time staging entry (it is
// @import-ed from .openElement/tailwind-preset/), which is why the path
// climbs out of that directory. `pnpm dev` serves the tokens convention
// (app/styles/tokens.css); the compiled bundle exists in the build output.
// No node: imports here on purpose — the starter's `check` surface has no
// @types/node, and vite resolves `root` to an absolute path already.

function tailwindPreset(): Plugin {
  let config: ResolvedConfig | undefined;
  return {
    name: 'starter:tailwind-preset',
    apply: 'build',
    configResolved(resolved) {
      config = resolved;
    },
    async closeBundle() {
      if (!config || config.command !== 'build') return;
      const outDir = `${config.root}/${config.build.outDir || 'dist'}`;
      await applyTailwindPreset({ theme: ['../../app/styles/theme.css'] }, config, outDir);
    },
  };
}

export default defineConfig({
  base: '/',
  plugins: [...openElement(), tailwindPreset()],
});

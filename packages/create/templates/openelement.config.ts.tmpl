// openelement.config.ts — framework options have exactly one home: this file.
//
// Every option below is OPTIONAL. With an empty object, options come from the
// file conventions:
//   - design tokens: app/styles/theme.css (the @theme role sheet; dev serves
//     it directly, the build compiles it through the `tailwind` key below)
//   - app shell:     app/islands/app-shell.tsx (auto-registered; the file is
//                    deletable and pages still render)
//   - document head: app/head.tsx (structural head content: meta tags, font
//                    preloads, icons, inline CSS — the entries a URL list
//                    cannot express; `head` below covers the rest)
//   - site title:    the "name" field of package.json
//
// The conventions follow `dirs`: give the three roots a shared leading
// directory (src/routes, src/islands, src/components) and the tokens/app-shell/
// head conventions resolve under that same directory (src/styles/tokens.css,
// src/islands/app-shell.tsx, src/head.tsx).
//
// Passing framework options inline to openElement() while this file carries
// options is a hard error: framework options cannot have two homes. Unknown
// keys are rejected with the accepted-key list.
import { defineConfig } from '@openelement/router';

export default defineConfig({
  // The Tailwind preset — the single-default scaffold form. The roles in
  // app/styles/theme.css compile into the preset's linked, layer-ordered
  // bundle (/assets/open-tailwind.css) after the SSG render; the path climbs
  // out of the preset's build-time staging entry (.openElement/
  // tailwind-preset/), the file the @import resolves from. `pnpm dev` serves
  // the authored sheet directly.
  tailwind: { theme: ['../../app/styles/theme.css'] },
  head: {
    // Titles default to the package.json "name"; this overrides the document
    // title fallback while page routes keep their own `head: { title }`.
    title: 'openElement Showcase',
    description: 'A static-first openElement showcase — rendered before JavaScript arrives.',
    favicon: '/openelement-mark.svg',
  },
});

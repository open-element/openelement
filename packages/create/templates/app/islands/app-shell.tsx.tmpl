/**
 * app/islands/app-shell.tsx — the auto-registered application shell.
 *
 * The convention path is enough: the build finds this module, registers its
 * compiled class under the `app-shell` tag, and renders EVERY page inside
 * it, projecting the page's own render into the default <slot>. The header
 * and footer markup that used to be copied onto every page lives here
 * exactly once — a page module now carries only its own content.
 *
 * The shadow root (root: 'shadow-open') is what makes the projection work:
 * the chrome below renders in this element's shadow tree (styled by the
 * site-chrome sheet in `static styles`), while the slotted page content
 * stays in the page element's own light DOM with its own @scope styles.
 * Layout tokens from app/styles/theme.css inherit through the boundary.
 *
 * The shell is a convention, not a requirement: delete this file and every
 * page still renders (back to carrying its own chrome), or opt out
 * explicitly with `appShell: false` in openelement.config.ts.
 */
import { element, OpenElement } from "@openelement/element";
import siteChromeStyles from "../components/site-chrome.css";

@element("app-shell", { root: "shadow-open" })
export default class AppShell extends OpenElement {
  static override styles = [siteChromeStyles];

  render() {
    return (
      <div class="page-body">
        <header class="site-head">
          <div class="bar">
            <a class="site-brand" href="/">
              openElement
            </a>
            <nav>
              <a href="/">Home</a>
              <a href="/about">About</a>
              <a href="/api/ping">API</a>
            </nav>
          </div>
        </header>
        <main>
          <slot></slot>
        </main>
        <footer class="site-foot">
          <div class="bar">
            <span>Generated by @openelement/create.</span>
            <a href="https://openelement.org">openelement.org</a>
          </div>
        </footer>
      </div>
    );
  }
}

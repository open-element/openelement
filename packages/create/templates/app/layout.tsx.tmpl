/**
 * app/layout.tsx — the auto-registered layout: header, main slot and footer
 * exist here exactly once, so a page module carries only its own content.
 *
 * A convention, not a requirement: delete the file and pages render their own
 * chrome again, or opt out with `layout: false` in openelement.config.ts.
 */
import { defineIslandConfig } from "@openelement/router";

/**
 * The convention layout on the generated-element lane (2026-11-20).
 *
 * The class this template used to declare is a function component plus the
 * sidecar below. The tag is the router's convention constant, and the entry
 * registers the host through the generated host PAIR channel, so the layout
 * renders as a generated element instead of a class.
 *
 * LIGHT root on purpose. The chrome is styled with Tailwind utilities, and a
 * LIGHT root's CSS is a DOCUMENT resource: the utilities ride the compiled
 * document sheet, and the host's box rule lives in `app/styles/theme.css`
 * (`app-layout { display: block }`). Page content still projects through the
 * `<slot>` — the generated light-root producer substitutes it at the slot.
 * A shadow root would need the utilities inside its shadow tree, which requires
 * a component-sheet link channel the generated lane has no app-local
 * declaration for (package components declare it in their manifest; an app's
 * own layout does not).
 */
export const openElement = defineIslandConfig({
  tag: "app-layout",
});

function Layout() {
  return (
    <div>
      <header class="site-head border-b border-line bg-paper">
        <div class="mx-auto flex max-w-(--content-width) items-baseline justify-between gap-4 px-5 py-4">
          <a
            class="text-[1.1rem] font-bold tracking-[-0.01em] text-ink no-underline hover:text-brand"
            href="/"
          >
            openElement
          </a>
          <nav class="flex gap-5">
            <a
              class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
              href="/"
            >
              Home
            </a>
            <a
              class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
              href="/about"
            >
              About
            </a>
            <a
              class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
              href="/api/ping"
            >
              API
            </a>
          </nav>
        </div>
      </header>
      <main class="mx-auto max-w-(--content-width) px-5 pt-12 pb-16">
        <slot></slot>
      </main>
      <footer class="site-foot border-t border-line text-[0.85rem] text-ink-soft">
        <div class="mx-auto flex max-w-(--content-width) flex-wrap justify-between gap-4 p-5">
          <span>Generated by @openelement/create.</span>
          <a class="text-ink-soft no-underline hover:text-brand" href="https://openelement.org">
            openelement.org
          </a>
        </div>
      </footer>
    </div>
  );
}

export default Layout;

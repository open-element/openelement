/**
 * app/layout.tsx — the auto-registered layout.
 *
 * The convention path is enough: the build finds this module, registers its
 * compiled class under the `app-layout` tag, and renders EVERY page inside
 * it, projecting the page's own render into the default <slot>. The header
 * and footer markup lives here exactly once — a page module carries only its
 * own content.
 *
 * The shadow root (root: 'shadow-open') is what makes the projection work:
 * the chrome below renders in this element's shadow tree, while the slotted
 * page content stays in the page element's own light DOM. Layout tokens from
 * app/styles/theme.css inherit through the boundary.
 *
 * Every rule that names an element below is a Tailwind utility in the markup
 * (the chrome's class tokens compile into the scaffold's component
 * stylesheet and reach this shadow root as a marked <link>); the sheet in
 * `static styles` holds only the host box, which has no markup to carry it.
 *
 * The layout is a convention, not a requirement: delete this file and every
 * page still renders (back to carrying its own chrome), or opt out
 * explicitly with `layout: false` in openelement.config.ts.
 */
import { element, OpenElement } from "@openelement/element";
import siteChromeStyles from "./components/site-chrome.css";

@element("app-layout", { root: "shadow-open" })
export default class Layout extends OpenElement {
  static override styles = [siteChromeStyles];

  render() {
    return (
      <div>
        <header class="site-head border-b border-line bg-paper">
          <div class="mx-auto flex max-w-(--content-width) items-baseline justify-between gap-4 px-5 py-4">
            <a
              class="text-[1.1rem] font-bold tracking-[-0.01em] text-ink no-underline hover:text-brand"
              href="/"
            >
              openElement
            </a>
            <nav class="flex gap-5">
              <a
                class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
                href="/"
              >
                Home
              </a>
              <a
                class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
                href="/about"
              >
                About
              </a>
              <a
                class="text-[0.95rem] font-medium text-ink-soft no-underline hover:text-brand"
                href="/api/ping"
              >
                API
              </a>
            </nav>
          </div>
        </header>
        <main class="mx-auto max-w-(--content-width) px-5 pt-12 pb-16">
          <slot></slot>
        </main>
        <footer class="site-foot border-t border-line text-[0.85rem] text-ink-soft">
          <div class="mx-auto flex max-w-(--content-width) flex-wrap justify-between gap-4 p-5">
            <span>Generated by @openelement/create.</span>
            <a class="text-ink-soft no-underline hover:text-brand" href="https://openelement.org">
              openelement.org
            </a>
          </div>
        </footer>
      </div>
    );
  }
}

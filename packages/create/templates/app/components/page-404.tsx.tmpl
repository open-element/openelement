/**
 * Styled 404 page element (#923): the request-time server renders this page
 * with a 404 status for unmatched paths; SSG builds also emit it as static
 * 404.html. The path-derived tag is 'el-404'. Light root: the page owns its
 * rules via `static styles` (./page-styles.ts), inlined into SSR as
 * @scope(el-404).
 */
import { element, OpenElement } from '@openelement/element';
import { notFoundPageStyles } from './page-styles.ts';

@element('el-404', { root: 'light' })
export default class NotFoundPage extends OpenElement {
  static override styles = notFoundPageStyles;

  render() {
    return (
      <main>
        <h1>404</h1>
        <p>The page you are looking for does not exist.</p>
        <p>
          <a href='/'>Back to the homepage</a>
        </p>
      </main>
    );
  }
}

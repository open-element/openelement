/**
 * Styled 404 page element (#923): the request-time server renders this page
 * with a 404 status for unmatched paths; a build with no request-time route
 * prerenders the route (see ./../routes/404.tsx) to dist/404.html instead.
 * The path-derived tag is 'el-404'. Light root: the page owns its
 * rules via `static styles` (the imported .css sheets), inlined into SSR as
 * @scope(el-404). The site chrome sheet (./site-chrome.css) is shared
 */
import { element, OpenElement } from '@openelement/element';
import notFoundPageStyles from './page-404.css';
import siteChromeStyles from './site-chrome.css';

@element('el-404', { root: 'light' })
export default class NotFoundPage extends OpenElement {
  static override styles = [notFoundPageStyles, siteChromeStyles];

  render() {
    return (
      <div class='page-body'>
        <header class='site-head'>
          <div class='bar'>
            <a class='site-brand' href='/'>
              openElement
            </a>
            <nav>
              <a href='/'>Home</a>
              <a href='/about'>About</a>
              <a href='/api/ping'>API</a>
            </nav>
          </div>
        </header>
        <main>
          <h1>404</h1>
          <p>The page you are looking for does not exist.</p>
          <p>
            <a href='/'>Back to the homepage</a>
          </p>
        </main>
        <footer class='site-foot'>
          <div class='bar'>
            <span>Generated by @openelement/create.</span>
            <a href='https://openelement.org'>openelement.org</a>
          </div>
        </footer>
      </div>
    );
  }
}

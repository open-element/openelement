/**
 * Styled 404 page element (#923): the request-time server renders this page
 * with a 404 status for unmatched paths; a build with no request-time route
 * prerenders the route (see ./../routes/404.tsx) to dist/404.html instead.
 * The path-derived tag is 'el-404'. Light root: presentation is authored as
 * Tailwind utility classes in the markup, and the one rule in `static styles`
 * is the root's own box, which has no markup to carry it. Like every page it
 * renders inside the layout (app/layout.tsx), which owns the header and
 * footer.
 */
import { element, OpenElement } from "@openelement/element";
import notFoundPageStyles from "./page-404.css";

@element("el-404", { root: "light" })
export default class NotFoundPage extends OpenElement {
  static override styles = [notFoundPageStyles];

  render() {
    return (
      <div class="page-content">
        <h1 class="mt-3 mb-2 text-[2.4rem] font-bold tracking-[-0.02em]">404</h1>
        <p class="leading-[1.6] text-ink-soft">The page you are looking for does not exist.</p>
        <p class="leading-[1.6] text-ink-soft">
          <a class="font-semibold text-brand no-underline hover:underline" href="/">
            Back to the homepage
          </a>
        </p>
      </div>
    );
  }
}

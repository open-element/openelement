/**
 * Home page element — the showcase landing page (static prerendered, the
 * default renderIntent mode).
 *
 * Compiled page: the render() below is lowered to a Part Program at build
 * time. The page uses a light root; its presentation is authored directly as
 * Tailwind utility classes, which compile into the document stylesheet the
 * build emits as a content-addressed asset and the served document declares
 * as a marked <link rel="stylesheet"> — so the page is styled with zero
 * client JS, and no CSS text is inlined or shipped in JavaScript. The one
 * rule in `static styles` is the root's own box, which has no markup to carry
 * it. The two island hosts (<my-counter>, <live-timer>) are static
 * custom-element hosts that the generated server entry expands through the
 * islands' own compiled classes.
 *
 * The site chrome (header, main block, footer) is NOT here: every page
 * renders inside the auto-registered layout
 * (app/layout.tsx), which owns that markup exactly once. The
 * compiled grammar lowers one root per render, so the page returns a single
 * content wrapper and the layout's <slot> carries it.
 *
 * The badge spans name each section's client cost: static sections ship
 * markup only; island sections hydrate a compiled island (see the island
 * modules under app/islands/).
 */
import { element, OpenElement } from "@openelement/element";
import homePageStyles from "./page-home.css";

@element("index-page", { root: "light" })
export default class HomePage extends OpenElement {
  static override styles = [homePageStyles];

  render() {
    // Single root element: the compiled grammar lowers one root per render.
    return (
      <div class="page-content">
        <section class="pt-10 pb-4">
          <span class="inline-flex items-center gap-[0.4em] rounded-full border border-ok/35 bg-ok/8 px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-ok uppercase">
            static · 0 KB JS
          </span>
          <p class="m-0 text-[0.78rem] font-semibold tracking-[0.14em] text-brand uppercase">
            openElement starter
          </p>
          <h1 class="mt-3 mb-4 max-w-[22ch] text-[clamp(2.2rem,6vw,3.2rem)] leading-[1.1] font-bold tracking-[-0.02em]">
            Rendered before JavaScript arrives
          </h1>
          <p class="m-0 max-w-[56ch] text-[1.12rem] leading-[1.75] text-ink-soft">
            Every page here is prerendered HTML. JavaScript loads only where a section is
            interactive — the badges below name the cost of each block. Edit{" "}
            <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
              app/routes/index.tsx
            </code>{" "}
            to make it yours.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              class="inline-block rounded-(--radius-m) border border-brand bg-brand px-[1.15rem] py-[0.6rem] font-semibold text-brand-ink no-underline transition-opacity duration-150 ease-out hover:opacity-[0.88] hover:no-underline"
              href="/about"
            >
              How it works
            </a>
            <a
              class="inline-block rounded-(--radius-m) border border-line bg-paper px-[1.15rem] py-[0.6rem] font-semibold text-ink no-underline transition-[border-color,color] duration-150 ease-out hover:border-brand hover:text-brand hover:no-underline"
              href="https://openelement.org"
            >
              Read the docs
            </a>
          </div>
        </section>
        <section class="mt-10 rounded-(--radius-l) border border-line bg-paper px-7 py-6 shadow-(--shadow-1)">
          <div class="mb-2 flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="m-0 text-[1.3rem] tracking-[-0.01em]">Interactive island</h2>
            <span class="inline-flex items-center gap-[0.4em] rounded-full border border-brand/40 bg-brand-soft px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-brand uppercase">
              island · hydrates on idle
            </span>
          </div>
          <p class="mt-[0.35rem] mb-5 max-w-[60ch] text-ink-soft">
            The counter is a compiled island (
            <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
              app/islands/my-counter.tsx
            </code>
            ): the server renders its markup, the browser hydrates it when idle.
          </p>
          <my-counter></my-counter>
        </section>
        <section class="mt-10 rounded-(--radius-l) border border-line bg-paper px-7 py-6 shadow-(--shadow-1)">
          <div class="mb-2 flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="m-0 text-[1.3rem] tracking-[-0.01em]">Live stats</h2>
            <span class="inline-flex items-center gap-[0.4em] rounded-full border border-brand/40 bg-brand-soft px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-brand uppercase">
              island · client-only
            </span>
          </div>
          <p class="mt-[0.35rem] mb-5 max-w-[60ch] text-ink-soft">
            Elapsed time on this page (
            <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
              app/islands/live-timer.tsx
            </code>
            ) renders only in the browser — a live clock has nothing meaningful to prerender, so the
            island ships{" "}
            <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
              ssr: false
            </code>
            .
          </p>
          <live-timer></live-timer>
        </section>
        <section class="mt-10 rounded-(--radius-l) border border-line bg-paper px-7 py-6 shadow-(--shadow-1)">
          <div class="mb-2 flex flex-wrap items-baseline justify-between gap-4">
            <h2 class="m-0 text-[1.3rem] tracking-[-0.01em]">The architecture</h2>
            <span class="inline-flex items-center gap-[0.4em] rounded-full border border-ok/35 bg-ok/8 px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-ok uppercase">
              static · 0 KB JS
            </span>
          </div>
          <p class="mt-[0.35rem] mb-5 max-w-[60ch] text-ink-soft">
            This section — like the hero above — is plain prerendered HTML and CSS. No framework
            script runs it.
          </p>
          <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-4 p-0">
            <li class="rounded-(--radius-m) border border-line bg-surface px-[1.15rem] py-4">
              <span class="inline-flex items-center gap-[0.4em] rounded-full border border-ok/35 bg-ok/8 px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-ok uppercase">
                static
              </span>
              <h3 class="mt-[0.6rem] mb-[0.35rem] text-[1rem]">Prerendered pages</h3>
              <p class="m-0 text-[0.9rem] leading-[1.6] text-ink-soft">
                Routes under{" "}
                <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
                  app/routes/
                </code>{" "}
                compile to static HTML at build time (SSG) and keep their HTTP cache semantics.
              </p>
            </li>
            <li class="rounded-(--radius-m) border border-line bg-surface px-[1.15rem] py-4">
              <span class="inline-flex items-center gap-[0.4em] rounded-full border border-brand/40 bg-brand-soft px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-brand uppercase">
                island
              </span>
              <h3 class="mt-[0.6rem] mb-[0.35rem] text-[1rem]">Islands where needed</h3>
              <p class="m-0 text-[0.9rem] leading-[1.6] text-ink-soft">
                Interactive pieces live in{" "}
                <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
                  app/islands/
                </code>{" "}
                and hydrate on the strategy each one declares — idle, load, visible, or client-only.
              </p>
            </li>
            <li class="rounded-(--radius-m) border border-line bg-surface px-[1.15rem] py-4">
              <span class="inline-flex items-center gap-[0.4em] rounded-full border border-ok/35 bg-ok/8 px-[0.65rem] py-[0.2rem] text-[0.72rem] font-semibold tracking-[0.04em] text-ok uppercase">
                static
              </span>
              <h3 class="mt-[0.6rem] mb-[0.35rem] text-[1rem]">Platform APIs</h3>
              <p class="m-0 text-[0.9rem] leading-[1.6] text-ink-soft">
                Server routes (
                <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
                  app/routes/api/
                </code>
                ) are plain{" "}
                <code class="rounded-[5px] border border-line bg-surface px-[0.35em] py-[0.08em] font-mono text-[0.85em]">
                  Request → Response
                </code>{" "}
                handlers — WinterCG-shaped, no framework runtime attached.
              </p>
            </li>
          </ul>
        </section>
      </div>
    );
  }
}

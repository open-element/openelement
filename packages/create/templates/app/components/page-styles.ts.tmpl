/**
 * Style sheets for the showcase starter's compiled elements (v0.44).
 *
 * Page sheets live in this plain module (compiled modules may not carry
 * runtime top-level statements, and page components are not islands). Page
 * elements use light roots: the server inlines their sheets into the SSR
 * output as a @scope(<page-tag>) block (<style data-oe-static-styles>), so
 * pages are styled with zero client JS. Under @scope the host tag prefixes
 * of a document stylesheet are dropped: the page element itself is `:host`
 * and descendant selectors go unprefixed.
 *
 * ISLAND sheets are same-module `compiledStyle()` consts in the island
 * modules under the island style asset protocol — cross-module
 * sheet imports fail closed (OEC9028). This module ships the factory helper
 * the islands spell.
 */
import { StyleSheet, type StyleSheetLike } from '@openelement/element';

export function compiledStyle(css: string): StyleSheetLike {
  const instance: StyleSheetLike = new StyleSheet();
  instance.replaceSync(css);
  return instance;
}

// ─── Site chrome (every page spreads this sheet; one source) ───
//
// The showcase starter ships no app-shell island: the header and footer are
// plain markup inside each light-root page, styled once here. Deleting a
// page's header markup or this sheet keeps the page rendering.

export const siteChromeStyles = [
  compiledStyle(`
    :host { display: block; }
    .site-head { border-bottom: 1px solid var(--line); background: var(--paper); }
    .site-head .bar { max-width: var(--content-width); margin: 0 auto; padding: 1rem 1.25rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
    .site-brand { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; }
    .site-brand:hover { color: var(--brand); text-decoration: none; }
    .site-head nav { display: flex; gap: 1.25rem; }
    .site-head nav a { color: var(--ink-soft); font-size: 0.95rem; font-weight: 500; text-decoration: none; }
    .site-head nav a:hover { color: var(--brand); text-decoration: none; }
    main { max-width: var(--content-width); margin: 0 auto; padding: 3rem 1.25rem 4rem; }
    .site-foot { border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.85rem; }
    .site-foot .bar { max-width: var(--content-width); margin: 0 auto; padding: 1.25rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .site-foot a { color: var(--ink-soft); text-decoration: none; }
    .site-foot a:hover { color: var(--brand); text-decoration: none; }
  `),
];

// ─── JS-cost badges (the showcase's cost vocabulary) ───
//
// Badges mark what each section costs the client: `static` sections ship
// markup only, `island` sections hydrate a compiled island. Pure CSS — the
// badge is itself part of the zero-JS surface.

export const badgeStyles = [
  compiledStyle(`
    .badge { display: inline-flex; align-items: center; gap: 0.4em; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; border: 1px solid var(--line); color: var(--ink-soft); background: var(--surface); }
    .badge-static { border-color: color-mix(in srgb, var(--ok) 35%, transparent); color: var(--ok); background: color-mix(in srgb, var(--ok) 8%, transparent); }
    .badge-island { border-color: color-mix(in srgb, var(--brand) 40%, transparent); color: var(--brand); background: var(--brand-soft); }
  `),
];

// ─── Page sheets (light roots → inlined as @scope(<page-tag>) in SSR) ───


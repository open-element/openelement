/**
 * About page element — the fully static showcase page.
 *
 * Compiled page with the default static renderIntent: prerendered to HTML at
 * build time (SSG). There are NO islands on this page — everything below is
 * prerendered markup and CSS. The header, footer and badges come from the
 * shared sheets in ./site-chrome.css and ./badges.css (light root, inlined
 * into SSR as @scope(about-page)).
 */
import { element, OpenElement } from '@openelement/element';
import aboutPageStyles from './page-about.css';
import badgeStyles from './badges.css';
import siteChromeStyles from './site-chrome.css';

@element('about-page', { root: 'light' })
export default class AboutPage extends OpenElement {
  static override styles = [aboutPageStyles, badgeStyles, siteChromeStyles];

  render() {
    return (
      <div class='page-body'>
        <header class='site-head'>
          <div class='bar'>
            <a class='site-brand' href='/'>
              openElement
            </a>
            <nav>
              <a href='/'>Home</a>
              <a href='/about'>About</a>
              <a href='/api/ping'>API</a>
            </nav>
          </div>
        </header>
        <main>
          <span class='badge badge-static'>static · no islands on this page</span>
          <p class='eyebrow'>About</p>
          <h1>Static first, interactive where it counts</h1>
          <p class='lede'>
            openElement prerenders pages to plain HTML and CSS at build time and
            hydrates compiled islands only where a page needs interactivity. This
            page is the first half of that story: it ships no islands at all.
          </p>
          <h2>What happened when you opened this page</h2>
          <p>
            The server sent HTML — prerendered at build time by SSG — plus one
            inlined stylesheet per page scope. No framework runtime executed to
            produce what you are reading; the markup is the artifact.
          </p>
          <h2>Where things live</h2>
          <ul class='conventions'>
            <li>
              <code>app/routes/</code>
              <span>page routes — one file per URL, prerendered by default</span>
            </li>
            <li>
              <code>app/routes/api/</code>
              <span>request-time server routes — plain Request → Response handlers</span>
            </li>
            <li>
              <code>app/components/</code>
              <span>compiled page elements and shared style sheets</span>
            </li>
            <li>
              <code>app/islands/</code>
              <span>client islands — the only code that ships JavaScript</span>
            </li>
            <li>
              <code>app/styles/tokens.css</code>
              <span>design tokens, inlined into every document head</span>
            </li>
            <li>
              <code>app/head.tsx</code>
              <span>structural document-head content (meta tags, preloads)</span>
            </li>
          </ul>
          <h2>See it working</h2>
          <p>
            The <a href='/'>home page</a> carries the interactive half: a counter
            island that hydrates on idle and a client-only live timer. Open your
            browser's DevTools on both pages and compare the network panels — the
            badge on each section names what it costs.
          </p>
        </main>
        <footer class='site-foot'>
          <div class='bar'>
            <span>Generated by @openelement/create.</span>
            <a href='https://openelement.org'>openelement.org</a>
          </div>
        </footer>
      </div>
    );
  }
}

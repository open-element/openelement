/**
 * About page element — the fully static showcase page.
 *
 * Compiled page with the default static renderIntent: prerendered to HTML at
 * build time (SSG). There are NO islands on this page — everything below is
 * prerendered markup and CSS. The page renders inside the auto-registered
 * app shell (app/islands/app-shell.tsx), which owns the header, main region
 * and footer; the badges come from ./badges.css (light root, inlined into
 * SSR as @scope(about-page)). The compiled grammar lowers one root per
 * render, so the page returns a single content wrapper.
 */
import { element, OpenElement } from "@openelement/element";
import aboutPageStyles from "./page-about.css";
import badgeStyles from "./badges.css";

@element("about-page", { root: "light" })
export default class AboutPage extends OpenElement {
  static override styles = [aboutPageStyles, badgeStyles];

  render() {
    return (
      <div class="page-content">
        <span class="badge badge-static">static · no islands on this page</span>
        <p class="eyebrow">About</p>
        <h1>Static first, interactive where it counts</h1>
        <p class="lede">
          openElement prerenders pages to plain HTML and CSS at build time and hydrates compiled
          islands only where a page needs interactivity. This page is the first half of that story:
          it ships no islands at all.
        </p>
        <h2>What happened when you opened this page</h2>
        <p>
          The server sent HTML — prerendered at build time by SSG — plus one inlined stylesheet per
          page scope. No framework runtime executed to produce what you are reading; the markup is
          the artifact.
        </p>
        <h2>Where things live</h2>
        <ul class="conventions">
          <li>
            <code>app/routes/</code>
            <span>page routes — one file per URL, prerendered by default</span>
          </li>
          <li>
            <code>app/routes/api/</code>
            <span>request-time server routes — plain Request → Response handlers</span>
          </li>
          <li>
            <code>app/components/</code>
            <span>compiled page elements and shared style sheets</span>
          </li>
          <li>
            <code>app/islands/</code>
            <span>client islands — the only code that ships JavaScript</span>
          </li>
          <li>
            <code>app/islands/app-shell.tsx</code>
            <span>the shared site chrome wrapped around every page</span>
          </li>
          <li>
            <code>app/styles/theme.css</code>
            <span>design tokens, inlined into every document head</span>
          </li>
          <li>
            <code>app/head.tsx</code>
            <span>structural document-head content (meta tags, preloads)</span>
          </li>
        </ul>
        <h2>See it working</h2>
        <p>
          The <a href="/">home page</a> carries the interactive half: a counter island that hydrates
          on idle and a client-only live timer. Open the browser DevTools on both pages and compare
          the network panels — the badge on each section names what it costs.
        </p>
      </div>
    );
  }
}

{
  "imports": {
    "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.25.3",
    "@openelement/router": "npm:@openelement/router@${v.router}",
    "@openelement/router/vite": "npm:@openelement/router@${v.router}/vite",
    "@openelement/router/nitro-mount": "npm:@openelement/router@${v.router}/nitro-mount",
    "@openelement/element": "npm:@openelement/element@${v.element}",
    "@openelement/element/build-utils": "npm:@openelement/element@${v.element}/build-utils",
    "@openelement/element/jsx-dev-runtime": "npm:@openelement/element@${v.element}/jsx-dev-runtime",
    "@openelement/element/jsx-runtime": "npm:@openelement/element@${v.element}/jsx-runtime",
    "hono": "npm:hono@^4.12",
    "vite": "npm:vite@8.0.16"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "tasks": {
    "dev": "deno run --config deno.json --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys --allow-ffi npm:vite@8.0.16",
    "check": "deno check --config deno.json app/ vite.config.ts",
    "test": "deno test --config deno.json --permit-no-files",
    "build": "deno run --config deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run npm:@openelement/router@${v.router}/cli/build",
    "start": "deno run --config deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run npm:@openelement/router@${v.router}/cli/start",
    "preview": "deno run --config deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run npm:@openelement/router@${v.router}/cli/start --mode=preview"
  },
  "compilerOptions": { "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx", "jsxImportSource": "@openelement/element" }
}

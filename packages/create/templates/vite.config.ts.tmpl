import { openElement } from '@openelement/router/vite';
import { defineConfig } from 'vite';

// Vite configuration only. Framework options live in openelement.config.ts —
// the plugin reads that file itself, so this stays `plugins: [openElement()]`.
// The JSX transform is owned by the plugin's compiler pass (TSX → Part
// Program); nothing JSX-related needs configuring here.
export default defineConfig({
  base: '/',
  plugins: [...openElement()],
});

{
  "name": "@openelement/create",
  "version": "1.0.0-alpha.1",
  "exports": "./src/cli.ts",
  "imports": {},
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net src/cli.ts",
    "build": "deno check src/",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --allow-ffi --allow-sys",
    "lint": "deno lint src/ __tests__/",
    "typecheck": "deno check src/"
  },
  "publish": {
    "include": [
      "src/cli.ts",
      "src/template-builder.ts",
      "src/version.ts",
      "templates",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "include": [
    "src",
    "templates"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

{
  "name": "@openelement/adapter-vite",
  "version": "0.44.0-beta.2.1",
  "exports": {
    ".": "./src/index.ts",
    "./element": "./src/element.ts",
    "./nitro-mount": "./src/nitro-mount.ts",
    "./sitemap": "./src/sitemap.ts",
    "./cli/build": "./src/cli/build.ts",
    "./cli/start": "./src/cli/start.ts"
  },
  "imports": {
    "@mdx-js/rollup": "npm:@mdx-js/rollup@^3.1.1",
    "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.25.3",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "jsonc-parser": "npm:jsonc-parser@^3.3.1",
    "marked": "npm:marked@^15.0.0",
    "typescript": "npm:typescript@^5.9.0",
    "hono": "npm:hono@^4.12",
    "vite": "npm:vite@8.0.16"
  },
  "tasks": {
    "build": "deno check src/",
    "test": "deno test -A",
    "lint": "deno lint src/ __tests__/",
    "typecheck": "deno check src/"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/__tests__/**",
      "__tests__/**",
      "__fixtures__/**"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

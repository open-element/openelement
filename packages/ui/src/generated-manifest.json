          "description": "variant attribute"
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "Default slot"
        },
        {
          "name": "header",
          "description": "The 'header' slot"
        },
        {
          "name": "footer",
          "description": "The 'footer' slot"
        }
      ],
      "cssParts": [
        {
          "name": "container",
          "description": "The article wrapper"
        },
        {
          "name": "body",
          "description": "The card body content area"

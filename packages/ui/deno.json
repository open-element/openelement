{
  "name": "@openelement/ui",
  "version": "1.0.0-alpha.2",
  "exports": {
    ".": "./src/index.ts",
    "./open-button": "./src/open-button.tsx",
    "./open-card": "./src/open-card.tsx",
    "./open-input": "./src/open-input.tsx",
    "./open-code-block": "./src/open-code-block.tsx",
    "./open-badge": "./src/open-badge.tsx",
    "./open-theme-toggle": "./src/open-theme-toggle.tsx",
    "./open-dialog": "./src/open-dialog.tsx",
    "./open-callout": "./src/open-callout.tsx",
    "./open-dropdown": "./src/open-dropdown.tsx",
    "./open-tabs": "./src/open-tabs.tsx",
    "./open-props-tokens": "./src/open-props-tokens.ts",
    "./open-props-tokens.js": "./src/open-props-tokens.ts"
  },
  "imports": {},
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@openelement/element"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "tasks": {
    "build": "deno check src/index.ts",
    "test": "deno test --deny-ffi --no-prompt --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys",
    "lint": "deno lint src/ __tests__/",
    "typecheck": "deno check src/index.ts",
    "generate:ui-tokens": "deno run --allow-read --allow-write --allow-env --allow-net tools/generate-ui-tokens.ts",
    "ui-tokens:check": "deno run --allow-read --allow-write --allow-env --allow-net tools/generate-ui-tokens.ts --check",
    "generate:ui-manifest": "deno run --allow-read --allow-write --allow-env tools/generate-ui-manifest.ts",
    "ui-manifest:check": "deno run --allow-read --allow-write --allow-env tools/generate-ui-manifest.ts --check"
  }
}

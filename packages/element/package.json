{
  "name": "@openelement/element",
  "version": "1.0.0-alpha.16",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./css-modules": "./src/css-modules.d.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./authoring": "./src/authoring.ts",
    "./html": "./src/html.ts",
    "./server": "./src/server.ts",
    "./logger": "./src/logger.ts",
    "./build-utils": "./src/build-utils.ts",
    "./internal/compiled/generated-element/shell": "./src/internal/compiled/generated-element/shell.ts",
    "./internal/compiled/leaf-runtime": "./src/internal/compiled/leaf-runtime.ts",
    "./internal/styles": "./src/internal/styles-entry.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./document-services": "./src/document-services.ts"
  },
  "sideEffects": false,
  "files": [
    "src/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src __tests__",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project element",
    "test:ci": "vitest run --root ../.. --project element --coverage",
    "browser:compile": "node __wtr__/tools/compile-fixtures.ts",
    "browser:install": "node ../../tools/repo/run-in.ts --root __wtr__ --env PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 -- npm ci --no-audit --no-fund",
    "browser:test": "pnpm run browser:compile && vitest run --root ../.. --project element-browser",
    "browser:negative": "node __wtr__/tools/negative-proofs.ts",
    "browser:gate": "pnpm run browser:install && pnpm run browser:test && pnpm run browser:negative",
    "browser:gate:full": "pnpm run browser:install && OE_BROWSER_MATRIX=full pnpm run browser:test && OE_BROWSER_MATRIX=full pnpm run browser:negative"
  },
  "dependencies": {
    "@openelement/protocol": "workspace:*"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@lit/context": "1.1.6",
    "@preact/signals-core": "^1.12.1",
    "@types/node": "26.5.0",
    "lit": "3.3.3",
    "vite": "8.1.6"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@openelement/element",
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true
  },
  "files": [
    "src/index.ts",
    "src/client-only.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts",
    "src/authoring.ts",
    "src/html.ts",
    "src/logger.ts",
    "src/build-utils.ts",
    "src/compiler.ts",
    "src/vite.ts"
  ]
}

{
  "imports": {
    "@openelement/site-ui/": "./app/site-ui/",
    "@openelement/generated/blog-data": "./app/data/_generated-blog-data.ts",
    "marked": "npm:marked@^15.0.0",
    "gray-matter": "npm:gray-matter@^4.0.3"
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ]
  },
  "include": [
    "app",
    "content",
    "public",
    "e2e",
    "__tests__"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "tasks": {
    "build": "deno run --config ../deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run ../packages/router/src/cli/build.ts",
    "test": "deno test --config ../deno.json --allow-read --allow-write --allow-env --allow-net --allow-run --allow-ffi --allow-sys __tests__/",
    "pagefind": "deno run --config ../deno.json --allow-read --allow-write --allow-env --allow-run --allow-net build-pagefind.ts",
    "e2e:browsers": "deno run --config ../deno.json --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys ../tools/repo/site-e2e-run.ts"
  }
}

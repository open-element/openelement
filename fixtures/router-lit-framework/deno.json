{
  "nodeModulesDir": "auto",
  "exclude": [
    "e2e"
  ],
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "deno.ns"
    ],
    "strict": true,
    "skipLibCheck": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-sloppy-imports"
      ]
    }
  },
  "imports": {
    "@openelement/router": "../../packages/router/src/index.ts",
    "@openelement/router/lit": "../../packages/router/src/lit.ts",
    "@openelement/router/lit-ssr": "../../packages/router/src/lit-ssr.ts",
    "@openelement/element": "../../packages/element/src/index.ts",
    "@openelement/element/jsx-runtime": "../../packages/element/src/jsx-runtime.ts",
    "@openelement/element/jsx-dev-runtime": "../../packages/element/src/jsx-dev-runtime.ts",
    "@openelement/element/build-utils": "../../packages/element/src/build-utils.ts",
    "@openelement/element/sanitize": "../../packages/element/src/sanitize.ts",
    "@openelement/element/authoring": "../../packages/element/src/authoring.ts",
    "@openelement/element/html": "../../packages/element/src/html.ts",
    "@openelement/element/logger": "../../packages/element/src/logger.ts",
    "@openelement/element/": "../../packages/element/src/",
    "lit": "npm:lit@3.3.3",
    "@lit-labs/ssr": "npm:@lit-labs/ssr@4.1.0",
    "@lit-labs/ssr-client": "npm:@lit-labs/ssr-client@1.1.8"
  },
  "tasks": {
    "build": "deno run --config ../../../deno.json --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-sys --allow-run ../../packages/router/src/cli/build.ts",
    "e2e": "deno run -A npm:@playwright/test@1.59.1 test --config e2e/playwright.config.ts --project=chromium",
    "e2e:browsers": "deno run -A npm:@playwright/test@1.59.1 test --config e2e/playwright.config.ts"
  }
}

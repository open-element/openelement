{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@playwright/test": "npm:@playwright/test@1.59.1"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys",
    "qualify": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys qualify.ts"
  },
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "strict": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}

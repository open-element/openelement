{
  "openelement-www": {
    "version": "3.0.0",
    "description": "www token contract references Open Props and @openelement/ui semantic tokens",
    "sourceOfTruth": "packages/ui/src/open-props-tokens.ts",
    "policy": {
      "colors": "semantic-token-only",
      "spacing": "open-props-size-scale",
      "radius": "open-props-radius-scale",
      "typography": "open-props-font-scale",
      "pageHardcoding": "forbidden"
    },
    "roles": {
      "canvas": { "value": "{--bg-base}" },
      "surface": { "value": "{--bg-card}" },
      "elevated": { "value": "{--bg-elevated}" },
      "mutedSurface": { "value": "{--bg-surface}" },
      "code": { "value": "{--bg-code}" },
      "text": { "value": "{--text-primary}" },
      "textSecondary": { "value": "{--text-secondary}" },
      "textMuted": { "value": "{--text-muted}" },
      "border": { "value": "{--border}" },
      "action": { "value": "{--brand}" },
      "standards": { "value": "{--success}" },
      "planned": { "value": "{--warning}" },
      "reference": { "value": "{--info}" }
    }
  }
}

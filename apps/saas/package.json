{
  "name": "@openelement/saas",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "build": "node ../../packages/router/src/cli/build.ts",
    "nitro:build": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys ../../tools/release/nitro-build.ts --root . --preset node-server --out .output-node --prune-public server",
    "start": "node ../../packages/router/src/cli/start.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "deno test --no-lock --no-check --allow-env --allow-read app/__tests__/",
    "nitro:build-workers": "deno run --no-lock --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys ../../tools/release/nitro-build.ts --root . --preset cloudflare_module --out .output-workers --prune-public server"
  },
  "dependencies": {
    "@openelement/element": "workspace:*",
    "@openelement/router": "workspace:*",
    "@supabase/realtime-js": "^2.84.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.84.0",
    "hono": "^4.12",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@std/assert": "jsr:1",
    "@types/node": "26.5.0",
    "typescript": "6.0.3"
  }
}

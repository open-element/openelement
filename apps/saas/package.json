{
  "name": "@openelement/saas",
  "private": true,
  "version": "1.0.0-alpha.16",
  "type": "module",
  "scripts": {
    "build": "node ../../packages/router/src/cli/build.ts",
    "nitro:build": "node ../../tools/release/nitro-build.ts --root . --preset node-server --out .output-node",
    "start": "node ../../packages/router/src/cli/start.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --project saas",
    "test:notes-live:browser": "node scripts/notes-live-browser.ts",
    "nitro:build-workers": "node ../../tools/release/nitro-build.ts --root . --preset cloudflare_module --out .output-workers",
    "test:workspace-onboarding:browser": "node scripts/workspace-onboarding-browser.ts",
    "test:attachment-storage": "sh scripts/attachment-storage-proof.sh",
    "test:workspace-rls": "sh scripts/workspace-rls-proof.sh"
  },
  "dependencies": {
    "@openelement/compiler": "workspace:*",
    "@openelement/element": "workspace:*",
    "@openelement/router": "workspace:*",
    "@supabase/realtime-js": "^2.84.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.84.0",
    "vite": "8.1.6"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "6.0.3"
  }
}

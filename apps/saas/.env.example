# Reference starter env — copy to .env for local runs (`deno task start`
# forwards the process env to loaders); on Workers these arrive via
# `wrangler --var` / dashboard secrets. Server-side only: the build must
# never ship them to the client bundle (tools/check-fullstack-boundary.ts,
# #984). The service-role key is part of this env, consumed only by the
# server-side webhook/checkout/lifecycle handlers — it must never be
# prefixed with VITE_ or rendered into the client bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Webhook-only server secrets. Never prefix these with VITE_ or render them.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-server-key
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_secret
STRIPE_LIVEMODE=false
# Prefer a restricted key with Checkout Sessions Write only. A broad `sk_`
# secret remains a compatibility fallback; store either value as a Worker secret.
STRIPE_SECRET_KEY=rk_test_your_checkout_sessions_write_key
STRIPE_PRICE_ID=price_your_fixed_catalog_price
STRIPE_CHECKOUT_HOST=checkout.stripe.com
APP_ORIGIN=http://localhost:4173
# Optional OAuth provider switches (#998): a provider button renders on /login
# only when its flag is exactly `true` AND the provider is configured in the
# Supabase dashboard; anything else renders "OAuth providers: not configured".
SUPABASE_OAUTH_GOOGLE_ENABLED=false
SUPABASE_OAUTH_GITHUB_ENABLED=false

{
  "name": "@openelement/example-fresh",
  "version": "0.41.0-alpha.6",
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "check": "deno install && deno check main.ts client.ts custom-elements.d.ts routes/index.tsx islands/OpenElements.tsx islands/PreactCounter.tsx"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@openelement/ui": "npm:@openelement/ui@0.44.0-beta.1",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "fresh/runtime": "jsr:@fresh/core@^2.3.3/runtime",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.4",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "meta",
      "title"
    ],
    "types": [
      "vite/client"
    ]
  },
  "workspace": []
}

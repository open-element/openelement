{
  "name": "@openelement/tools-repo",
  "private": true,
  "version": "1.0.0-alpha.7",
  "type": "module",
  "scripts": {
    "assets:check-provenance": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-assets-provenance.ts",
    "generate:all": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/generate-all.ts",
    "generator-gates:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-generator-gates.ts",
    "deps:vite-check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/deps-vite-check.ts",
    "esm:boundary-check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-esm-boundary.ts",
    "export-files:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/generate-openelement-export-files.ts --check",
    "version-bump": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/version-bump.ts",
    "workspace:links:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-workspace-links.ts",
    "interface:snapshot": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-public-interface-snapshot.ts",
    "interface:snapshot:write": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-public-interface-snapshot.ts --write",
    "release:state-machine:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-release-state-machine.ts --offline",
    "retired-api:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-retired-api-refs.ts",
    "signals:check-protocol-boundary": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-signal-protocol-boundary.ts",
    "test:coverage:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-coverage.ts --threshold 80 --branch-threshold 84 --function-threshold 86",
    "gate:ts7:shadow": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/ts7-shadow-gate.ts",
    "validation:boundary-check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-validation-boundary.ts",
    "workers:boundary-check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-workers-boundary.ts apps/saas/.output-workers",
    "lint:markdown": "node ../../tools/repo/run-in.ts --root ../.. -- markdownlint-cli2 \"**/*.md\"",
    "url-pattern-list:provenance": "node ../../tools/repo/run-in.ts --root ../.. -- npm ci --prefix tests/fixtures/url-pattern-list-audit --ignore-scripts --no-audit --no-fund && node ../../tools/repo/run-in.ts --root ../.. -- npm audit signatures --prefix tests/fixtures/url-pattern-list-audit --ignore-scripts",
    "hooks:install": "git -C ../.. config core.hooksPath .githooks && chmod +x ../../.githooks/pre-commit ../../.githooks/pre-push",
    "hooks:uninstall": "git -C ../.. config --unset core.hooksPath",
    "gate:source": "node ../../tools/repo/gate.ts tools/repo#generate:all tools/repo#typecheck check:dep-age packages/element#test packages/router#test tools/repo#lint:markdown www#check:content-dates tools/repo#interface:snapshot tests/fixtures/router-request-time#gate packages/element#browser:gate",
    "gate:release": "node ../../tools/repo/gate.ts tools/repo#generate:all www#check:api-reference www#check:errors www#check:error-codes www#check:install-command www#check:content-data www#check:article-routes packages/ui#ui-tokens:check tools/repo#generator-gates:check tools/repo#product:classification:check www#check:routes-types tools/release#graph:check tools/repo#deps:vite-check tools/repo#esm:boundary-check packages/ui#ui-manifest:check tools/repo#export-files:check tools/repo#url-pattern-list:provenance tools/repo#release:state-machine:check tools/repo#signals:check-protocol-boundary tools/repo#assets:check-provenance tools/repo#workspace:links:check tools/repo#validation:boundary-check build site:build www#check:nav www#check:links www#check:machine-paths www#check:doc-figures www#check:theme-tokens www#check:content tools/repo#retired-api:check www#check:retired-url tools/repo#test:coverage:check tests/fixtures/router-static-only#build tests/fixtures/router-native-framework#gate tests/fixtures/router-lit-framework#gate tests/fixtures/router-ui-dogfood#gate tests/fixtures/site-light-probe#gate tests/fixtures/web-component-interop#test packages/element#browser:gate:full tests/e2e/starter-smoke#gate tests/fixtures/router-nitro#proof:node tests/fixtures/router-nitro#proof:workers www#e2e:browsers",
    "typecheck": "node ../../tools/repo/run-in.ts --root ../.. -- tsc --noEmit -p tools/tsconfig.json",
    "candidate:evidence:fast": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --job fast-checks --out .artifacts/ci/fast-checks",
    "candidate:evidence:source": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --job source-matrix --out .artifacts/ci/source-matrix",
    "candidate:evidence:packed": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --job packed --out .artifacts/ci/packed",
    "candidate:evidence:fresh": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --job fresh-clone --out .artifacts/ci/fresh-clone",
    "candidate:evidence:aggregate": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --aggregate --input-dir .artifacts/ci --output .artifacts/candidate-evidence.json",
    "candidate:evidence:validate": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/candidate-evidence.ts --validate .artifacts/candidate-evidence.json --max-age-days 14",
    "candidate:evidence:reuse:resolve": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/evidence-reuse.ts --resolve",
    "candidate:evidence:reuse:claim": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/evidence-reuse.ts --claim",
    "release:registry-check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-release-state-machine.ts",
    "product:classification:check": "node ../../tools/repo/run-in.ts --root ../.. -- node tools/repo/check-product-classification.ts"
  },
  "devDependencies": {
    "@std/assert": "jsr:^1.0.0",
    "@std/cli": "jsr:^1.0.0",
    "@std/fs": "jsr:^1.0.0",
    "@std/path": "jsr:^1.0.0",
    "@std/semver": "jsr:^1.0.0",
    "@types/node": "26.5.0",
    "markdownlint-cli2": "0.23.2",
    "typescript": "6.0.3",
    "valibot": "^1.1",
    "vite": "8.0.16",
    "zod": "^3.25"
  }
}

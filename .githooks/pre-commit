#!/bin/sh
#
# openElement pre-commit hook. Format/lint are owned by the Deno toolchain
# directly; the repository task graph keeps only OpenElement-specific dev gates.
#
# Install: deno task hooks:install

set -e

deno fmt --check
deno lint

echo "[autoflow:dev] pre-commit"
deno task autoflow:dev || {
  echo ""
  echo "autoflow:dev FAILED. Fix the issues above and retry."
  exit 1
}

echo ""
echo "autoflow:dev PASSED; commit allowed."

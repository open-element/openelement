#!/bin/sh
#
# openElement pre-push hook. Format/lint run through the repository script
# graph (oxfmt/oxlint); Markdown lint and typecheck stay on their pinned
# OSS tools, and the OpenElement-specific push gates follow.
#
# Install: pnpm --filter @openelement/tools-repo run hooks:install

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)

pnpm run fmt:check
pnpm run lint
pnpm --dir tools/repo run lint:markdown
pnpm run typecheck

echo "=== pre-push gates for '$BRANCH' ==="

pnpm --dir tools/release run graph:check
# pack-surface:check reads the packed tarballs (pack:dry-run writes them); with
# none present it fails closed and names that task itself (#1541).
node_modules/.bin/vp run --fail-if-no-match @openelement/tools-release#pack-surface:check
pnpm --dir tools/repo run export-files:check

echo ""
echo "All gates passed."

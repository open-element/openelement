#!/bin/sh
#
# openElement pre-push hook. Format/lint/type-graph/Markdown are owned by the
# pinned OSS tools directly; the repository task graph owns the
# OpenElement-specific push gates.
#
# Install: deno task --cwd tools/repo hooks:install

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)

deno fmt --check
deno lint
deno task --cwd tools/repo lint:markdown
deno task typecheck

echo "=== pre-push gates for '$BRANCH' ==="

deno task --cwd tools/release graph:check
deno task --cwd tools/repo export-files:check

echo ""
echo "All gates passed."

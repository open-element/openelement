#!/bin/sh
#
# openElement pre-push hook. Format/lint run through the repository script
# graph (oxfmt/oxlint); Markdown lint and typecheck stay on their pinned
# OSS tools, and the OpenElement-specific push gates follow.
#
# One dispatch surface: `node_modules/.bin/vp run` in the fail-closed
# `--filter` form, identical to the argv CI uses for the same gates
# (autoflow-ci.yml) and to tools/repo/vp-dispatch.ts's vpTaskArgv (P6 — the
# hook and CI are one gate graph, not two mechanisms). `vp run` owns no gate
# logic, so retiring vp is an edit of these lines, not a re-derivation of the
# gates (P5). The binary is spelled with its path because a git hook inherits
# no node_modules/.bin PATH.
#
# Install: pnpm --filter @openelement/tools-repo run hooks:install

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD)

node_modules/.bin/vp run --no-cache --fail-if-no-match --filter openelement fmt:check
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter openelement lint
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter @openelement/tools-repo lint:markdown
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter openelement typecheck

echo "=== pre-push gates for '$BRANCH' ==="

node_modules/.bin/vp run --no-cache --fail-if-no-match --filter @openelement/tools-release graph:check
# pack-surface:check reads the REAL tarball bytes. Rebuild them first, exactly
# as the CI pack job does: a tarball left over from an earlier build is stale
# input, so a newly shipped text violation would pass locally and fail only on
# the remote (#1708 CI run 42087248453). With none present the check still
# fails closed and names the task itself (#1541).
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter @openelement/tools-release pack:dry-run
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter @openelement/tools-release pack-surface:check
node_modules/.bin/vp run --no-cache --fail-if-no-match --filter @openelement/tools-repo export-files:check

echo ""
echo "All gates passed."

# Dependencies
node_modules/

# Deno
.deno/
vendor/*
# Keep vendored dependency attribution tracked for license compliance
!vendor/jsr.io/
!vendor/jsr.io/@std/
# Deno materializes JSR sources during a frozen install. Keep only license
# attribution under each module; generated source/version metadata is cache.
vendor/jsr.io/@std/*
!vendor/jsr.io/@std/*/
vendor/jsr.io/@std/*/*
!vendor/jsr.io/@std/*/LICENSE
!vendor/jsr.io/@std/LICENSE
!vendor/jsr.io/@std/ATTRIBUTION.md

# Build output
dist/
custom-dist/
dist-test-*/
fixtures/router-nitro/.output-*/
fixtures/router-nitro/.wrangler/
fixtures/router-nitro/.nitro/
fixtures/router-nitro/node_modules/
fixtures/router-request-time/.output-*/
fixtures/router-request-time/.nitro/
.openElement/

# npm (Deno project - no npm lockfiles)
package-lock.json
# Exception: the WTR browser world uses its lockfile as a hermetic pin.
!packages/element/__wtr__/package-lock.json
# Exception: npm audit signatures requires a committed exact dependency graph.
!tools/fixtures/url-pattern-list-audit/package-lock.json

# npm pack tarballs
packages/*/*.tgz
*.tgz

# Environment
.env
.env.local
.env.*.local
# Credential-bearing variants in any package/example (deploy secrets, wrangler
# dev vars); placeholder templates stay tracked.
**/.env.production
**/.env.*.production
**/.dev.vars
**/.dev.vars.*
**/.wrangler/
**/.wrangler-async.generated.json
**/supabase/.temp/
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Packed-starter smoke workdir (regenerated by `deno task starter-smoke:setup`)
e2e/starter-smoke/work/

# Micro benchmark evidence dump (regenerated by `deno run benchmarks/micro/micro.ts --write`)
benchmarks/micro/micro-evidence.json

# Testing
coverage/
.coverage/
.coverage-*/
.coverage-check/
__test_fixtures__/
playwright-report/
test-results/

# Framework internals
.workbuddy/
.gstack/
.qoder/
.codebuddy/settings.local.json

# Vite cache
.vite/
/.wrangler/

# Root-level logo source files (design originals, keep local)
/open-logo*.svg
/open-favicon.svg

hub-index/
hub-submission.json

# Local implementation prompts are intentionally outside the product repository.
/docs/prompts/

# Local agent-skill tooling (installed via `npx skills add`, user-local only)
/.agents/
/.codebuddy/
/.grok/
/.trae/
/.zcode/
/skills/
/skills-lock.json

# Root-local media/agent scratch artifacts (never release inputs)
/.tmp/
/.tmp-*
# Release workflow (autoflow-release.yml) PR-CI evidence download dir: CI scratch, never a release input
/.artifacts/

# Dependencies
node_modules/

# Deno
.deno/
vendor/*
# Keep vendored dependency attribution tracked for license compliance
!vendor/jsr.io/
!vendor/jsr.io/@std/
# Deno materializes JSR sources during a frozen install. Keep only license
# attribution under each module; generated source/version metadata is cache.
vendor/jsr.io/@std/*
!vendor/jsr.io/@std/*/
vendor/jsr.io/@std/*/*
!vendor/jsr.io/@std/*/LICENSE
!vendor/jsr.io/@std/LICENSE
!vendor/jsr.io/@std/ATTRIBUTION.md

# Build output
dist/
custom-dist/
dist-test-*/
www/dist/
packages/adapter-vite/__fixtures__/nitro-proof/.output-*/
packages/adapter-vite/__fixtures__/nitro-proof/.wrangler/
packages/adapter-vite/__fixtures__/nitro-proof/.nitro/
packages/adapter-vite/__fixtures__/nitro-proof/node_modules/
packages/adapter-vite/__fixtures__/request-time/.output-*/
packages/adapter-vite/__fixtures__/request-time/.nitro/
www/app/data/_generated-blog-data.ts
www/app/data/_generated-guide-data.ts
www/app/data/_generated-architecture-data.ts
.openElement/
www/.openElement/

# npm (Deno project - no npm lockfiles)
package-lock.json
# Exceptions: the npm-local worlds whose lockfiles ARE the hermetic pin —
# the WTR pilot (#1333; wtr:pilot:gate runs `npm ci`) and the TS7 experiment
# toolchain (#1156 evidence reproducibility).
!packages/element/__wtr__/package-lock.json
!tools/experiments/ts7/toolchain/package-lock.json

# npm pack tarballs
packages/*/*.tgz
*.tgz

# Environment
.env
.env.local
.env.*.local
# Credential-bearing variants in any package/example (deploy secrets, wrangler
# dev vars); placeholder templates stay tracked.
**/.env.production
**/.env.*.production
**/.dev.vars
**/.dev.vars.*
**/.wrangler/
**/.wrangler-async.generated.json
**/supabase/.temp/
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Packed-starter smoke workdir (regenerated by `deno task starter-smoke:setup`)
e2e/starter-smoke/work/

# Testing
coverage/
.coverage/
.coverage-*/
.coverage-check/
__test_fixtures__/
playwright-report/
test-results/

# Framework internals
.workbuddy/
.gstack/
.qoder/
.codebuddy/settings.local.json

# Vite cache
.vite/
/.wrangler/

# Generated www data modules and the UI manifest are intentionally tracked.
# repo:hygiene fails if a tracked file also matches .gitignore.

# Root-level logo source files (design originals, keep local)
/open-logo*.svg
/open-favicon.svg

hub-index/
hub-submission.json

# Dogfood stress report: nightly artifact, not a tracked snapshot
# (regenerated by `deno task stress:dogfood`, archived as a CI artifact)
examples/deno-desktop-mastodon/stress-report.json

# Local agent-skill tooling (installed via `npx skills add`, user-local only)
/.agents/
!/.agents/
/.agents/*
!/.agents/v044-kimi-implementer.md
!/.agents/v044-kimi-release-verifier.md
/.codebuddy/
/.grok/
/.trae/
/.zcode/
/skills/
/skills-lock.json

# Root-local media/agent scratch artifacts (never release inputs)
/.tmp/
/.tmp-*
# Release workflow (autoflow-release.yml) PR-CI evidence download dir: CI scratch, never a release input
/.artifacts/

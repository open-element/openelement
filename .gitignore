# Dependencies
node_modules/

# Deno local cache (the toolchain retired the Deno host; the rule stays as a guard)
.deno/

# Local security-scanner hook state (written into the repo by the session's
# pre-push hook; pure tool state, not project source). Root-anchored and
# ignored so oxfmt/oxlint stay hermetic.
/.mimosa/
**/.mimosa/

# Generated Web Components interop qualification evidence. corpus.json is the
# canonical corpus; the qualifier regenerates both artifacts on every run.
tests/fixtures/web-component-interop/compiler-output.cem.json
tests/fixtures/web-component-interop/interop-evidence.json

# Generated site content data (regenerate with `pnpm --filter @openelement/www
# run generate:content`; API reference with `generate:api-reference`).
# Inputs live in www/content/; the files are regenerated before test
# and site:build.
www/app/data/_generated-*.ts

# Browser-conformance compiled fixtures (regenerated by
# `pnpm --filter @openelement/element run browser:compile`, which browser:test
# runs first); source is packages/element/__wtr__/fixtures + packages/ui/src.
packages/element/__wtr__/generated/

# Build output
dist/
custom-dist/
dist-test-*/
# Nitro/Vite-Nitro build output in any fixture (node-server, cloudflare_module,
# workers). One rule, not one per fixture: a new Nitro fixture must not depend
# on someone remembering to add its path here.
**/.output*/
**/.wrangler/
**/.nitro/
.openElement/

# npm lockfiles: the workspace is pnpm-managed (single pnpm-lock.yaml at the
# root); stray npm lockfiles never enter the tree.
# Exception: the element browser-conformance world uses its lockfile as a hermetic pin.
!packages/element/__wtr__/package-lock.json
# Exception: npm audit signatures requires a committed exact dependency graph.
!tests/fixtures/url-pattern-list-audit/package-lock.json

# npm pack tarballs
packages/*/*.tgz
*.tgz

# Environment
.env
.env.local
.env.*.local
# Credential-bearing variants in any package/example (deploy secrets, wrangler
# dev vars); placeholder templates stay tracked.
**/.env.production
**/.env.*.production
**/.dev.vars
**/.dev.vars.*
**/.wrangler/
**/.wrangler-async.generated.json
**/supabase/.temp/
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local dev-server process file (written at runtime, never a release input)
dev.pid

# Packed-starter smoke workdir (regenerated by
# `pnpm --filter @openelement/e2e-starter-smoke run setup`)
tests/e2e/starter-smoke/work/

# Micro benchmark evidence dump (regenerated by `node benchmarks/micro/micro.ts --write`)
benchmarks/micro/micro-evidence.json

# Testing
coverage/
.coverage/
.coverage-*/
.coverage-check/
__test_fixtures__/
playwright-report/
test-results/
.vitest/

# Framework internals
.workbuddy/
.gstack/
.qoder/
.codebuddy/settings.local.json

# Vite cache
.vite/
/.wrangler/

# Root-level logo source files (design originals, keep local)
/open-logo*.svg
/open-favicon.svg

hub-index/
hub-submission.json

# Local implementation prompts are intentionally outside the product repository.
/docs/prompts/

# Local agent-skill tooling (installed via `npx skills add`, user-local only)
/.agents/
/.codebuddy/
/.grok/
/.trae/
/.zcode/
/skills/
/skills-lock.json
# ZCode's local ignore file (a .gitignore sync target, user-local tool state)
.zcodeignore

# Root-local media/agent scratch artifacts (never release inputs)
/.tmp/
/.tmp-*
# Release workflow (autoflow-release.yml) PR-CI evidence download dir: CI scratch, never a release input
/.artifacts/

# Local agent-tool caches and workspace evidence (user-local, never release
# inputs). /evidence/ held 0.43.3 release tarballs; the directory is gone
# (#1415) and the rule stays so a future local evidence dump cannot be staged.
/.superpowers/
/.v2c/
/.mimosa/
/evidence/
